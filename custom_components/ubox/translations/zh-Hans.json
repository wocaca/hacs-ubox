{
  "flow": {
    "user": {
      "title": "UBox",
      "description": "代理 = Add-on MJPEG 摄像头。直连 = 纯 Python P2P 摄像头。云端 = 账号设备/用户/快照（实时视频事后在配置里加）。"
    },
    "proxy": {
      "title": "UBox 代理摄像头",
      "data": {
        "host": "Add-on 主机（HASS IP）",
        "port": "Add-on 端口"
      }
    },
    "relay": {
      "title": "UBox 中继摄像头（实验性）",
      "data": {
        "uid": "摄像头 UID",
        "username": "设备账号（admin）",
        "password": "设备密码",
        "relay": "中继 host:port",
        "stream": "码流类型（0 = 子码流）",
        "scan_interval": "轮询间隔秒（>=10）"
      },
      "description": "实验性：仅 360p IDR 快照。要 1080p 实时请用代理模式。"
    },
    "cloud": {
      "title": "UBox 云端（账号登录）",
      "data": {
        "account": "UBox 账号（手机/邮箱）",
        "password": "账号密码",
        "region": "区服"
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "UBox 实时视频",
        "description": "Add-on MJPEG 地址，配出实时摄像头实体。主机留空=不要实时实体。",
        "data": {
          "host": "Add-on 主机（HASS IP，空=不要）",
          "port": "Add-on 端口"
        }
      }
    }
  },
  "config": {
    "abort": {
      "camera_no_options": "摄像头条目没有额外选项。"
    }
  },
  "error": {
    "required": "此项必填。",
    "invalid": "值无效。",
    "missing_account": "账号和密码必填。",
    "cannot_connect": "登录失败，检查账号/密码/区服。"
  }
}
